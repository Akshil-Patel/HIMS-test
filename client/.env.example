# Production Backend API URL (hosted on Render)
# E.g. https://your-lipms-backend.onrender.com
# Leave empty for local development to use the Vite proxy (/api)
VITE_API_URL=https://your-lipms-backend.onrender.com

# Doctor Portal frontend URL (hosted on Vercel)
# E.g. https://your-doctor-portal.vercel.app
VITE_DOCTOR_PORTAL_URL=https://your-doctor-portal.vercel.app

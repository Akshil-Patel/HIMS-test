# Server Port (Render sets PORT automatically)
PORT=5000

# Node Environment
NODE_ENV=production

# MongoDB Connection String (MongoDB Atlas Free M0 Cluster)
# Example: mongodb+srv://dbUser:SecurePassword123@cluster0.abcde.mongodb.net/lipms?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/lipms?retryWrites=true&w=majority

# Backend Public Base URL (Render URL)
API_URL=https://your-lipms-backend.onrender.com

# Frontend URLs for CORS and Receipt Links
CLIENT_URL=https://your-lipms-billing.vercel.app
DOCTOR_PORTAL_URL=https://your-doctor-portal.vercel.app

